; Miku Windows installer built with Inno Setup.
; The build task passes AppVersion with /DAppVersion=... and defaults to the
; application version below for direct local compilation.

#define AppName "Miku"
#define AppPublisher "Aswanidev"
#define AppExeName "miku.exe"
#define AppDescription "A premium AniList client for tracking anime and manga"
#define AppCopyright "(c) 2025, Aswanidev"

#ifndef AppVersion
  #define AppVersion "0.12.2"
#endif

#define WebView2ClientKey "SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"

[Setup]
AppId={{A6C7B2E2-5F07-4B0A-9D0D-6A70F4A5C0A1}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL=https://github.com/Aswanidev-vs/Miku
AppSupportURL=https://github.com/Aswanidev-vs/Miku/issues
AppUpdatesURL=https://github.com/Aswanidev-vs/Miku/releases
AppCopyright={#AppCopyright}
DefaultDirName={autopf}\Miku
DefaultGroupName={#AppName}
CreateAppDir=yes
AppendDefaultDirName=yes
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
CloseApplications=yes
RestartApplications=yes
OutputDir=..\..\..\bin
OutputBaseFilename=Miku-{#AppVersion}-windows-setup
SetupIconFile=..\icon.ico
UninstallDisplayIcon={app}\{#AppExeName}
WizardStyle=modern
Compression=lzma2/ultra64
SolidCompression=yes
ChangesAssociations=no
VersionInfoVersion={#AppVersion}.0
VersionInfoProductVersion={#AppVersion}.0
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppDescription}
VersionInfoProductName={#AppName}
VersionInfoCopyright={#AppCopyright}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"

[Files]
Source: "..\..\..\bin\miku.exe"; DestDir: "{app}"; Flags: ignoreversion
; Generated by `wails3 generate webview2bootstrapper` before ISCC runs.
Source: "MicrosoftEdgeWebview2Setup.exe"; DestDir: "{tmp}"; Flags: deleteafterinstall; Check: not WebView2Installed

[Dirs]
Name: "{app}"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{tmp}\MicrosoftEdgeWebview2Setup.exe"; Parameters: "/silent /install"; StatusMsg: "Installing Microsoft Edge WebView2 Runtime..."; Flags: waituntilterminated; Check: not WebView2Installed
Filename: "{app}\{#AppExeName}"; Description: "Launch {#AppName}"; Flags: nowait postinstall skipifsilent

[Code]
function WebView2Installed: Boolean;
var
  InstalledVersion: String;
begin
  Result :=
    RegQueryStringValue(HKLM, '{#WebView2ClientKey}', 'pv', InstalledVersion) or
    RegQueryStringValue(HKLM, 'SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', InstalledVersion) or
    RegQueryStringValue(HKCU, '{#WebView2ClientKey}', 'pv', InstalledVersion);
end;
